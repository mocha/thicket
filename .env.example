# ---- required ---------------------------------------------------------------
# Postgres connection. With compose.yml this is built from POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://thicket:PASSWORD@localhost:5432/thicket
# The address people reach this instance at. Drives secure cookies, invite links,
# and how other instances refer to yours. Use the https address behind your proxy.
PUBLIC_URL=http://localhost:3000

# ---- compose.yml only --------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Host port to publish thicket on (remove ports: in compose.yml if a proxy routes to it)
PORT=3000

# ---- optional ---------------------------------------------------------------
# Shown on the sign-up page. Default: the PUBLIC_URL hostname.
INSTANCE_NAME=
# Sign-up policy seed for a fresh instance: open | invite | closed. The first
# account is always allowed (they become admin) and can change this in Settings.
SIGNUPS=invite
# Product analytics events. false records nothing about anyone's activity.
TRACK_ACTIVITY=true
# The plan every account gets unless an admin grants another: free | basic | advanced.
# advanced means no limits, which is what a self-hosted instance wants. Seeds the
# instance setting; the admin page changes it at runtime.
DEFAULT_PLAN=advanced
# Feed fetcher: parallel fetches and scheduler tick. SCHEDULER=off disables the
# in-process fetcher (for a large instance running fetchers separately).
FETCH_CONCURRENCY=8
SCHEDULER_TICK_MS=15000
SCHEDULER=on
# Retention, in days. 0 turns a window off entirely.
# Posts default to OFF and should stay off unless you need the space: a feed
# serves a window, not an archive, so a post deleted here usually cannot be
# fetched again — thicket often holds more history than the feed it came from.
# Posts someone wrote a note on are kept whatever this says.
RETAIN_ITEMS_DAYS=0
# Operational logs. Safe to forget: the fetch log alone otherwise grows faster
# than the posts it is logging.
RETAIN_FETCH_LOG_DAYS=90
RETAIN_EVENTS_DAYS=90
# Directory of the built web app for the API to serve. The container sets this;
# in dev leave it unset and run `pnpm web` alongside.
# WEB_DIR=
