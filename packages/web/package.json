{
  "name": "@thicket/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "palette": "node scripts/palette-swatches.mjs",
    "dev": "pnpm palette && vite dev --host --port 5173",
    "build": "pnpm palette && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "pnpm palette && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "svelte-easy-crop": "^5.0.1"
  }
}
